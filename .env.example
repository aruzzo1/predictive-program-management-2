# Copy this file to .env and fill in local values.
# .env is git-ignored. Never commit real keys.

# Optional: enables the grounded-generation step. Leave blank for retrieval-only mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Absolute path to the authoritative JSF/F-35 source corpus (read-only)
JSF_SOURCE_DIR=

# Retrieval settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_DIR=data/processed/chroma
CHROMA_COLLECTION=jsf_corpus
# Chunk sizes are in tokens of the embedding model's tokenizer
CHUNK_SIZE_TOKENS=220
CHUNK_OVERLAP_TOKENS=35
TOP_K=5
# Retrieval duplicate suppression
CANDIDATE_K=15
DEDUP_MIN_SHARED_WORDS=12

LOG_LEVEL=INFO
